engagement_name = "engagement-001"
aws_region      = "eu-central-1"

ssh_public_key = "ssh-ed25519 AAAA... operator@laptop"

operator_cidrs = [
  "203.0.113.10/32",
  "198.51.100.25/32",
]

# C2
c2_listener_port  = 443
dns_listener_port = 53

# GoPhish
gophish_admin_port = 3333
gophish_phish_port = 8080

# ---------- Evilginx ----------
evilginx_instance_type             = "t3.small"
evilginx_redirector_instance_type  = "t3.micro"
enable_evilginx_redirector         = true

# Domain Evilginx is authoritative for. MUST be in RoE scope.
# Its NS records get delegated to the Evilginx host.
# evilginx_domain = "secure-portal.example-engagement.com"

# Domains — MUST all be in RoE scope
# redirector_domain = "cdn.example-engagement.com"
# dns_c2_domain     = "tunnel.example-engagement.com"
# phishing_domain   = "secure-login.example-engagement.com"

# cloudflare_api_token = "xxxxx"
# cloudflare_zone_id   = "xxxxx"
